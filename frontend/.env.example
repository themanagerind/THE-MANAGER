# Copy this file to `.env` in the frontend/ folder and fill in real values.
# .env is for local development only — Vite also reads real env vars at
# build time in CI/production, so this file is documentation either way.

# Showcase (Ecom store)'s production host, used only by the Resident
# "Shop Now" button (src/components/ShopNowButton.tsx) to build the
# prefill redirect link. Leave unset until Showcase has a real domain —
# the button simply doesn't render rather than linking anywhere broken.
# No trailing slash.
VITE_SHOWCASE_BASE_URL=https://showcase.example.com
