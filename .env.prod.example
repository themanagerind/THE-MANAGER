# Copy to .env.prod (gitignored — see .gitignore's .env.* rule) and fill
# in real values before `docker compose -f docker-compose.prod.yml up`.
# Consumed by docker-compose.prod.yml's backend service (env_file) and,
# for POSTGRES_PASSWORD, by the postgres service directly.

# Generate with: openssl rand -hex 32 — signs every JWT; rotating it logs
# out every active session.
JWT_SECRET_KEY=

POSTGRES_PASSWORD=

# development | staging | production — "development" echoes OTPs back in
# the API response (app/api/v1/auth.py); never use it here.
ENVIRONMENT=production

# Shared secret the (future, separate) Ecom store's backend sends as
# X-Store-Api-Key when calling POST /wallet-redemptions/verify and
# POST /showcase-prefill/redeem. Leave unset (endpoints 503) until that
# integration is actually live.
ECOM_STORE_API_KEY=
