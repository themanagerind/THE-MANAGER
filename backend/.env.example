# Copy this file to `.env` in the backend/ folder and fill in real values.
# .env is for local development only — see app/core/config.py.

# Postgres connection string — must use the asyncpg driver (postgresql+asyncpg://).
# Create the database first, e.g.: createdb housing_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/housing_dev

# Any long random string works locally — this signs JWTs, so keep it secret in real deployments.
JWT_SECRET_KEY=change-this-to-any-long-random-string

# Redis — used for OTP storage/rate-limiting. Default db 0 is fine for local dev.
REDIS_URL=redis://localhost:6379/0

# development | staging | production
# In "development", POST /auth/otp/request echoes the OTP back in the
# response (dev_otp) and the Login page auto-fills it — no real SMS
# gateway is wired up, so this is the only way to log in locally.
ENVIRONMENT=development
