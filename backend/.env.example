# Copy this file to `.env` in the backend/ folder and fill in real values.
# .env is for local development only — see app/core/config.py.

# Postgres connection string — must use the asyncpg driver (postgresql+asyncpg://).
# Port 5433, not the standard 5432 — see docker-compose.yml's comment (avoids
# colliding with a native postgres.exe some Windows machines already have on 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/housing_dev

# Any long random string works locally — this signs JWTs, so keep it secret in real deployments.
JWT_SECRET_KEY=change-this-to-any-long-random-string

# Redis — used for OTP storage/rate-limiting. Port 6380, not the standard 6379
# — see docker-compose.yml's comment (avoids colliding with a native
# redis-server.exe some Windows machines already have on 6379). Default db 0
# is fine for local dev.
REDIS_URL=redis://localhost:6380/0

# development | staging | production
# In "development", POST /auth/otp/request echoes the OTP back in the
# response (dev_otp) and the Login page auto-fills it — no real SMS
# gateway is wired up, so this is the only way to log in locally.
ENVIRONMENT=development

# Twilio SMS for OTP delivery. Leave blank in local dev — the OTP is then
# just logged ("[MOCK SMS]"). Get these from console.twilio.com. Provide
# EITHER a messaging service SID OR a from number (E.164).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Prefixed to bare 10-digit mobiles to make them E.164.
SMS_DEFAULT_COUNTRY_CODE=+91

# Shared secret the (future, separate) Ecom store's backend sends as
# X-Store-Api-Key when calling POST /wallet-redemptions/verify. Any long
# random string works locally; leave unset to make that endpoint 503
# until a real Ecom store integration exists.
ECOM_STORE_API_KEY=change-this-to-any-long-random-string
