# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/coverage/
frontend/.vite/

# Backend
backend/venv/
backend/.venv/
**/__pycache__/
*.pyc
backend/.pytest_cache/
backend/.coverage
backend/uploads/
backend/dump.rdb

# Env files
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.tsbuildinfo
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Persistent Postgres data dir (managed by backend/bootstrap_env.sh)
.pgdata/

# Android TWA (bubblewrap) — signing key and build output are generated
# locally per android/README.md step 3; the keystore especially must never
# be committed (losing/leaking it is unrecoverable for Play Store updates).
android/*.keystore
android/*.jks
android/*.aab
android/*.apk
android/.gradle/
android/build/
android/app/build/

# .env.example is a committed template (no secrets, just documented
# placeholder values) — un-ignored here, after every .env*-matching
# pattern above, since gitignore negations only win over patterns earlier
# in the file.
!.env.example
!**/.env.example
